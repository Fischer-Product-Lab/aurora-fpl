{
  "name": "aurora-run-explorer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vinext dev",
    "dev:vercel": "next dev",
    "build": "vinext build",
    "build:vercel": "next build",
    "start": "vinext start",
    "start:vercel": "next start",
    "test": "npm run security:public && npm run build && node --test tests/rendered-html.test.mjs tests/replay.test.mjs tests/comparison.test.mjs",
    "verify:vercel": "npm run security:public && npm run test:vercel",
    "test:vercel": "npm run build:vercel && node --test tests/vercel-runtime.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "security:public": "node scripts/scan-public-artifacts.mjs"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.45.1",
    "@cloudflare/workers-types": "5.20260719.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.5",
    "react-server-dom-webpack": "19.2.9",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.1.5",
    "wrangler": "4.112.0"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "js-yaml": "4.3.0",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "next": {
      "postcss": "8.5.26"
    }
  },
  "type": "module"
}
